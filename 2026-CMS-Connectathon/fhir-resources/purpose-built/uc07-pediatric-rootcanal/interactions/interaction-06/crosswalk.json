    "onlineMemberId": {
      "system": "https://dentaquest.example.org/fhir/online-id",
      "value": "DQ-ONLINE-TX-0038211"
    },
    "thenRead": [
      "Coverage?beneficiary=Patient/patient-joe-castle-payer",
      "ExplanationOfBenefit?patient=Patient/patient-joe-castle-payer"
    ]
  },
